{
  "name": "chrome-jaunte-gcp-console",
  "description": "A Unofficial GCP Extension to \"jaunte\" around the console pages.",
  "version": "1.0.0",
  "repository": "ssh://git@github.com/pokutuna/chrome-jaunte-gcp-console.git",
  "author": "pokutuna <popopopopokutuna@gmail.com>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "check": "oxlint && oxfmt --check . && pnpm run typecheck",
    "fix": "oxlint --fix && oxfmt .",
    "typecheck": "tsc --noEmit",
    "posttest": "pnpm run check"
  }
}
